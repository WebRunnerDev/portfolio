// ADR-0001: one Worker serves the SPA through Workers Static Assets and owns /api/*.
// Local dev and builds go through @cloudflare/vite-plugin, which fills in `assets.directory`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webrunner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "binding": "ASSETS",
    // Unknown paths (deep links like /en/cv) get index.html instead of a 404.
    "not_found_handling": "single-page-application",
    // Everything but the hashed build output runs the Worker first: /api/*,
    // /media/* and HTML pages, which get Meta Injection (worker/README.md).
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "routes": [{ "pattern": "webrunner.dev", "custom_domain": true }],
  "workers_dev": false,
  // Previews still get <branch>-webrunner.<subdomain>.workers.dev URLs (with
  // `X-Robots-Tag: noindex`); Lighthouse CI runs against them. Applied by the
  // production `wrangler deploy`.
  "preview_urls": true,
  "observability": { "enabled": true },
  // ADR-0004: the Access application that guards /admin* and /api/admin/*.
  // Values come from the Zero Trust dashboard (worker/README.md › Admin access).
  "vars": {
    // <team>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "webrunner.cloudflareaccess.com",
    // The application's Application Audience (AUD) Tag.
    "ACCESS_AUD": "68e2aadff81d962098390f1d6a6b285001ed4425f1af5c3dbee17e2ad154e72f",
  },
  // ADR-0002: all content. Schema in migrations/. IDs come from
  // `wrangler d1 create` (worker/README.md › Deploy › One-time setup).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webrunner",
      // Production. `npm run db:migrate` migrates it before the deploy.
      "database_id": "dba20503-ef01-43b1-b035-4e56bfa6147b",
      // The Preview database (same ID as in `previews` below), so that
      // `npm run db:migrate:preview` (`--preview`) can reach it.
      "preview_database_id": "650f6c38-8265-4647-9a26-a1497a882582",
    },
  ],
  // Uploaded media (images, audio, PDFs), served on /media/<key>. Buckets come
  // from `wrangler r2 bucket create` (worker/README.md › Media).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "webrunner-media",
      // The Preview bucket (same as in `previews` below), for `--preview`.
      "preview_bucket_name": "webrunner-media-preview",
    },
  ],
  // Rate limits on /api/* (worker/api/rate-limit.ts, worker/README.md › Rate
  // limits). `period` is 10 or 60 seconds; RATE_LIMIT_PERIOD must match it.
  // `namespace_id` is any number unique within the account.
  "ratelimits": [
    // Reads, per IP and path.
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
    // /api/admin/* writes, per IP.
    {
      "name": "ADMIN_WRITE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    // POST /api/admin/uploads, per IP.
    {
      "name": "UPLOAD_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // Workers Builds runs `wrangler preview` for non-main branches, which needs
  // this block. Previews inherit everything above except what is listed here.
  "previews": {
    // Previews never touch the production database.
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "webrunner-preview",
        "database_id": "650f6c38-8265-4647-9a26-a1497a882582",
      },
    ],
    // Nor the production media.
    "r2_buckets": [
      { "binding": "MEDIA", "bucket_name": "webrunner-media-preview" },
    ],
  },
}
