{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "node scripts/audit/server.mjs 4175",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://localhost:4175/en",
        "http://localhost:4175/en/cv",
        "http://localhost:4175/en/projects",
        "http://localhost:4175/en/projects/edge-portfolio",
        "http://localhost:4175/en/gallery",
        "http://localhost:4175/en/gallery/astana",
        "http://localhost:4175/en/blog",
        "http://localhost:4175/en/blog/edge-caching",
        "http://localhost:4175/ar"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(projects|blog)/[^/]+$)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.65 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4500 }],
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 215040 }
            ]
          }
        },
        {
          "matchingUrlPattern": "/(projects|blog)/[^/]+$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.5 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4600 }],
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 307200 }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
