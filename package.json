{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && steiger ./src",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate": "node scripts/d1-migrate.mjs",
    "db:migrate:preview": "node scripts/d1-migrate.mjs --preview",
    "db:seed-cv": "node scripts/seed-cv.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/tektur": "^5.3.0",
    "@hono/standard-validator": "^0.4.0",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "^1.170.44",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "undici": "^7.30.1",
    "@cloudflare/vitest-plugin": {
      "zod": "^4.6.6"
    }
  }
}
